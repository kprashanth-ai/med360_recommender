# ─── Primary Provider: OpenAI ────────────────────────────────────────────────
# Required. Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Optional. Defaults to gpt-4o if not set.
OPENAI_MODEL=gpt-4o

# ─── Fallback Provider: OpenRouter ───────────────────────────────────────────
# Used only if OpenAI fails (rate limit, auth error, etc.)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── API Metadata (optional) ─────────────────────────────────────────────────
API_TITLE=Specialist Recommender API
API_VERSION=0.2.0
API_DESCRIPTION=AI-assisted triage API for specialist consultation booking.

# ─── Mock Mode (optional) ────────────────────────────────────────────────────
# Set to true to return a static response without calling any LLM.
# Useful for frontend development without API keys.
# MOCK_MODE=true

# ─── CORS (optional) ─────────────────────────────────────────────────────────
# Defaults to * (open) for local dev. Restrict before any shared deployment.
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.med360.com
CORS_ALLOW_ORIGINS=*
